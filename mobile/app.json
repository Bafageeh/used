{
  "expo": {
    "name": "مستعمل مجاني",
    "slug": "used",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "used",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.pm.used"
    },
    "android": {
      "package": "sa.pm.used",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول للصور لإضافتها إلى إعلانك."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نحتاج موقعك لتحديد مكان السلعة."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://used.pm.sa/api"
    }
  }
}
